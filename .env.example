# Copy to .env for local development. Never commit .env. Values below are placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://session_bridge:dev_only_change_me@127.0.0.1:5432/session_bridge
DATABASE_URL_TEST=postgresql://session_bridge:dev_only_change_me@127.0.0.1:5432/session_bridge_test
DB_POOL_MAX=10

# REQUIRED. >= 32 chars. Keys the HMAC that hashes retrieval tokens. Generate: openssl rand -base64 48
# Changing it invalidates every existing retrieval token. The CHANGE_ME value is rejected in production.
TOKEN_PEPPER=7x9Wv2mK4LpQzN1tB8vR5cE3wX6yM0uJ9aZ4

# Optional but recommended for a personal deployment: shared key required on POST /mcp (>= 24 chars).
# Add the same value in the claude.ai connector as a request header named X-Session-Bridge-Key.
# Generate: openssl rand -base64 32
# MCP_ACCESS_TOKEN=

# Behind a reverse proxy/platform: set true (or hop count / CIDR list) so client IPs and https are detected.
TRUST_PROXY=true
# Defaults to true when NODE_ENV=production (requests whose protocol is not https get 426; /health exempt).
# REQUIRE_HTTPS=true

# Size and retention
MAX_BODY_BYTES=262144
MEMORY_BUDGET_BYTES=65536
DEFAULT_RETENTION=30d
ALLOW_PERSISTENT_RETENTION=true
PERSISTENT_INACTIVITY_DAYS=365
TOMBSTONE_DAYS=7
CLEANUP_INTERVAL_MINUTES=60
REDACT_SECRETS=true
MAX_CONCURRENT_REQUESTS=200

# Rate limits (in-memory, per server instance)
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_GLOBAL_CREATE_PER_MIN=600
RATE_LIMIT_READ_PER_MIN=60
RATE_LIMIT_RESUME_PER_MIN=30
RATE_LIMIT_DELETE_PER_MIN=10
RATE_LIMIT_IP_PER_MIN=300
# Hosted MCP endpoint (/mcp): claude.ai calls it from a few shared Anthropic IPs, so per-IP ceilings are higher
RATE_LIMIT_MCP_IP_PER_MIN=1200
RATE_LIMIT_MCP_CREATE_PER_MIN=60
RATE_LIMIT_INVALID_PER_WINDOW=10
RATE_LIMIT_INVALID_IP_PER_WINDOW=50
RATE_LIMIT_INVALID_WINDOW_SECONDS=900
